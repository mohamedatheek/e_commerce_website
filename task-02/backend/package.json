{
  "name": "northline-checkout-api",
  "version": "1.0.0",
  "description": "E-Commerce Checkout & Payment System API (Task 02)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "prestart": "npm run migrate && npm run seed",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:check": "node src/db/check.js",
